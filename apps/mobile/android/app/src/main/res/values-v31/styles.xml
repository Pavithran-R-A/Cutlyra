<?xml version="1.0" encoding="utf-8"?>
<!-- Cutlyra Android 12+ splash (SplashScreen API). Only resource overrides
     are allowed on 12+ — the system draws the splash itself, from this icon,
     on this background. The icon source is the brand mark with real padding
     (the system masks the icon area     into a circle). windowSplashScreenBehavior icon_preferred keeps the
     icon splash even when a shortcut launch would otherwise fall back to
     the plain background. -->
<resources>
    <style name="Theme.Cutlyra.Splash" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
